{
	"info": {
		"_postman_id": "hms-api-collection-v1",
		"name": "HMS - Hotel Management System API",
		"description": "Laravel modular monolith HMS API (v1).\n\nBase path: `{{base_url}}` (default: http://localhost:8000/api/v1)\n\n**Quick start**\n1. Run `php artisan migrate` and `php artisan db:seed --class=HmsSeeder`\n2. Start server: `php artisan serve` or use Laravel Herd\n3. Run **Workflow → Full guest journey** folder in order\n\nCollection variables (`room_id`, `guest_id`, etc.) are auto-set by test scripts on key requests.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api/v1",
			"type": "string"
		},
		{
			"key": "room_id",
			"value": "1",
			"type": "string"
		},
		{
			"key": "guest_id",
			"value": "1",
			"type": "string"
		},
		{
			"key": "reservation_id",
			"value": "1",
			"type": "string"
		},
		{
			"key": "stay_id",
			"value": "1",
			"type": "string"
		},
		{
			"key": "invoice_id",
			"value": "1",
			"type": "string"
		},
		{
			"key": "check_in_date",
			"value": "",
			"type": "string"
		},
		{
			"key": "check_out_date",
			"value": "",
			"type": "string"
		},
		{
			"key": "invoice_total",
			"value": "",
			"type": "string"
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"const daysAhead = (n) => {",
					"    const d = new Date();",
					"    d.setDate(d.getDate() + n);",
					"    return d.toISOString().split('T')[0];",
					"};",
					"if (!pm.collectionVariables.get('check_in_date')) {",
					"    pm.collectionVariables.set('check_in_date', daysAhead(7));",
					"}",
					"if (!pm.collectionVariables.get('check_out_date')) {",
					"    pm.collectionVariables.set('check_out_date', daysAhead(10));",
					"}"
				]
			}
		}
	],
	"item": [
		{
			"name": "Workflow",
			"description": "Run these requests in order for an end-to-end demo.",
			"item": [
				{
					"name": "1. Search availability",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/availability?check_in_date={{check_in_date}}&check_out_date={{check_out_date}}&guests_count=2",
							"host": ["{{base_url}}"],
							"path": ["availability"],
							"query": [
								{
									"key": "check_in_date",
									"value": "{{check_in_date}}"
								},
								{
									"key": "check_out_date",
									"value": "{{check_out_date}}"
								},
								{
									"key": "guests_count",
									"value": "2"
								}
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"const json = pm.response.json();",
									"if (json.data && json.data.length > 0) {",
									"    pm.collectionVariables.set('room_id', json.data[0].id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "2. Create guest",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"first_name\": \"Alice\",\n  \"last_name\": \"Traveler\",\n  \"email\": \"alice.traveler.{{$timestamp}}@example.com\",\n  \"phone\": \"+1-555-0199\",\n  \"document_number\": \"P99887766\"\n}"
						},
						"url": "{{base_url}}/guests"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 201', () => pm.response.to.have.status(201));",
									"const json = pm.response.json();",
									"if (json.data && json.data.id) {",
									"    pm.collectionVariables.set('guest_id', json.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "3. Create reservation",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"room_id\": {{room_id}},\n  \"guest_id\": {{guest_id}},\n  \"check_in_date\": \"{{check_in_date}}\",\n  \"check_out_date\": \"{{check_out_date}}\",\n  \"guests_count\": 2,\n  \"special_requests\": \"Late check-in requested\"\n}"
						},
						"url": "{{base_url}}/reservations"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 201', () => pm.response.to.have.status(201));",
