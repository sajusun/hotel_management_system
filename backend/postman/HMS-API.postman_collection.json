						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/reservations/{{reservation_id}}/check-in"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 201', () => pm.response.to.have.status(201));",
									"const json = pm.response.json();",
									"if (json.data) {",
									"    pm.collectionVariables.set('stay_id', json.data.id);",
									"    if (json.data.invoice && json.data.invoice.id) {",
									"        pm.collectionVariables.set('invoice_id', json.data.invoice.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "5. Add service charge",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"description\": \"Room service breakfast\",\n  \"unit_price\": 25.00,\n  \"quantity\": 2,\n  \"type\": \"service\"\n}"
						},
						"url": "{{base_url}}/invoices/{{invoice_id}}/services"
					}
				},
				{
					"name": "6. Get invoice (before checkout)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/invoices/{{invoice_id}}"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"const json = pm.response.json();",
									"if (json.data && json.data.total_amount) {",
									"    pm.collectionVariables.set('invoice_total', json.data.total_amount);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "7. Check out",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/stays/{{stay_id}}/check-out"
					}
				},
				{
					"name": "8. Record payment",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": {{invoice_total}},\n  \"method\": \"card\",\n  \"transaction_reference\": \"TXN-{{$timestamp}}\"\n}"
						},
						"url": "{{base_url}}/invoices/{{invoice_id}}/payments"
					},
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"if (!pm.collectionVariables.get('invoice_total')) {",
									"    pm.collectionVariables.set('invoice_total', '500');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
